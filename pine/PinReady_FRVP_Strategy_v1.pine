f_smoothRows(array<float> rv, int passes) =>
    int n = array.size(rv)
    for p = 1 to passes
        array<float> tmp = array.new<float>(n, 0.0)
        for i = 0 to n - 1
            float a = i > 0 ? array.get(rv, i - 1) : array.get(rv, i)
            float b = array.get(rv, i)
            float cc = i < n - 1 ? array.get(rv, i + 1) : array.get(rv, i)
            array.set(tmp, i, (a + 2.0 * b + cc) / 4.0)
        for i = 0 to n - 1
            array.set(rv, i, array.get(tmp, i))
    true

// ───────────────────────────────────────────────────────────────────────────────
//  ⑥ FIXED-RANGE VOLUME PROFILE  (24 ردیف از کندل‌های تریگر۲ داخل کندل ساختار)
// ───────────────────────────────────────────────────────────────────────────────
f_buildProfile(array<Candle> micro, int rows, float vaPct, string dist, int smoothPasses) =>
    float lo = na
    float hi = na
    if array.size(micro) > 0
        lo := array.get(micro, 0).l
        hi := array.get(micro, 0).h
        for i = 1 to array.size(micro) - 1
            lo := math.min(lo, array.get(micro, i).l)
            hi := math.max(hi, array.get(micro, i).h)
    array<float> rv = array.new<float>(rows, 0.0)
    if not na(lo) and hi > lo
        float step0 = (hi - lo) / rows
        bool uniform = dist == "یکنواخت"
        for i = 0 to array.size(micro) - 1
            Candle m = array.get(micro, i)
            float anchor = dist == "مثلثی حول Typical Price" ? (m.h + m.l + m.c) / 3.0 : m.c
            float span = math.max(m.h - m.l, syminfo.mintick) * 1.2
            // پاس اول : مجموع وزن‌ها
            float wSum = 0.0
            for r = 0 to rows - 1
                float rBot = lo + r * step0
                float rTop = rBot + step0
                float ov = math.max(0.0, math.min(m.h, rTop) - math.max(m.l, rBot))
                if ov > 0
                    float w = uniform ? 1.0 : math.max(0.05, 1.0 - math.abs((rBot + rTop) / 2.0 - anchor) / span)
                    wSum += ov * w
            // پاس دوم : تخصیص حجم
            if wSum > 0
                for r = 0 to rows - 1
                    float rBot = lo + r * step0
                    float rTop = rBot + step0
                    float ov = math.max(0.0, math.min(m.h, rTop) - math.max(m.l, rBot))
                    if ov > 0
                        float w = uniform ? 1.0 : math.max(0.05, 1.0 - math.abs((rBot + rTop) / 2.0 - anchor) / span)
                        array.set(rv, r, array.get(rv, r) + m.v * ov * w / wSum)
    if smoothPasses > 0
        f_smoothRows(rv, smoothPasses)
    // POC + Value Area
    int poc = 0
    for r = 1 to rows - 1
        if array.get(rv, r) > array.get(rv, poc)
            poc := r
    float tot = array.sum(rv)
    array<bool> inVA = array.new<bool>(rows, false)
    array.set(inVA, poc, true)
    float acc = array.get(rv, poc)
    int cnt = 1
    while acc < tot * vaPct / 100.0 and cnt < rows
        int dn = poc - cnt
        int up = poc + cnt
        float dv = dn >= 0 ? array.get(rv, dn) : -1.0
        float uv = up < rows ? array.get(rv, up) : -1.0
        if dv < 0 and uv < 0
            break
        if uv >= dv
            array.set(inVA, up, true)
            acc += uv
        else
            array.set(inVA, dn, true)
            acc += dv
        cnt += 1
    float vaTop = na
    float vaBot = na
    if not na(lo) and hi > lo
        float step1 = (hi - lo) / rows
        int firstVA = -1
        int lastVA = -1
        for r = 0 to rows - 1
            if array.get(inVA, r)
                if firstVA < 0
                    firstVA := r
                lastVA := r
        if firstVA >= 0
            vaBot := lo + firstVA * step1
            vaTop := lo + (lastVA + 1) * step1
    float pocPrice = na
    if not na(lo) and hi > lo
        pocPrice := lo + (poc + 0.5) * (hi - lo) / rows
    Profile.new(rv, lo, (not na(lo) and not na(hi) and hi > lo) ? (hi - lo) / rows : 0.0, pocPrice, vaTop, vaBot)

// ساخت دو ناحیه مهم فیکس‌رنج  (الگوریتم دقیق کارفرما — نسخه اصلاح‌شده)
//  ⚠ POC هیچ نقشی در ساخت ناحیه‌ها ندارد.
//  صعودی (حرکت از کف به سقف):
//    ① اولین «قله» محلی: با رشد اعداد وارد می‌شویم و وقتی رشد متوقف شد، همان ردیف قله است.
//      مثال: 85,95,125,325,324 → قله = ردیف 325 (اولین عدد بزرگ)
//    ② کف محدوده = مرز بین قله و ردیف کوچک‌تر قبلش  (بین 125 و 325)
//    ③ اولین «دره» بعد از قله: با کاهش وارد می‌شویم و وقتی کاهش متوقف شد، همان ردیف دره است.
//      مثال: 324,254,117,226 → دره = ردیف 117
//    ④ سقف محدوده = مرز بین دره و ردیف بزرگ‌ترِ بعدش  (بین 117 و 226)
//    ⑤ محدوده دوم = تکرار همین دو مرحله بعد از دره  (قله 489 و دره 217 → کف بین 472/489 ، سقف بین 217/390)
//  نزولی: کاملاً قرینه (حرکت از سقف به کف)
//  شرط اعتبار: کلوز نباید داخل/روی محدوده باشد ; و محدوده باید حداقل minRows ردیف داشته باشد
f_zones(Profile p, int rows, bool bull, float cClose, int minRows) =>
    array<Zone> out = array.new<Zone>()
    array<Zone> rej = array.new<Zone>()
    array<float> rv = p.vol
    float lo = p.lo
    float step = p.step
    if rows >= 5 and step > 0 and not na(lo)
        int stepDir = bull ? 1 : -1
        int i = bull ? 0 : rows - 1
        int guard = 0
        while guard < 4 * rows and array.size(out) + array.size(rej) < 2
            guard += 1
            // ① اولین قله محلی در جهت حرکت
            //   «قله آخری، دره اولی»: حلقه بیرونی «صعود اکید → فلات» را تکرار می‌کند
            //   تا ردیف بعد اکیداً کوچک‌تر شود. بعد از فلات در صورت صعود مجدد ادامه
            //   می‌دهیم (مثلاً 20,20,20,30,50,50).
            int pk = -1
            int j = i
            bool climbed = false
            bool done = false
            while not done
                while j + stepDir >= 0 and j + stepDir <= rows - 1 and array.get(rv, j + stepDir) > array.get(rv, j)
                    j := j + stepDir; climbed := true
                while j + stepDir >= 0 and j + stepDir <= rows - 1 and array.get(rv, j + stepDir) == array.get(rv, j)
                    j := j + stepDir
                bool nextUp = j + stepDir >= 0 and j + stepDir <= rows - 1 and array.get(rv, j + stepDir) > array.get(rv, j)
                done := true
                if nextUp
                    done := false
            if j != i
                pk := j
            // قاعده قله تک‌ردیفه: اگر در نقطه شروع مانده‌ایم و ردیف بعد اکیداً کوچک‌تر
            // است، همین ردیف قله است (هم در آغاز پیمایش، هم بعد از هر دره).
            if pk < 0
                int nx = i + stepDir
                if nx >= 0 and nx <= rows - 1 and array.get(rv, nx) < array.get(rv, i)
                    pk := i; climbed := true
            if pk < 0
                break
            //  اگر کل حرکت هیچ صعود اکید نداشت (مثل پروفایل تخت) قله واقعی نیست.
            if not climbed
                break
            // ② اولین دره محلی بعد از قله — فلات نزولی را ادامه نمی‌دهیم (دره اولین است).
            int tr = -1
            int k = pk
            while k + stepDir >= 0 and k + stepDir <= rows - 1 and array.get(rv, k + stepDir) < array.get(rv, k)
                k := k + stepDir
            if k != pk and k + stepDir >= 0 and k + stepDir <= rows - 1
                tr := k
            if tr < 0
                break
            // ③ محدوده = از مرز پایین قله تا مرز بالای دره
            int loIdx = math.min(pk, tr)
            int hiIdx = math.max(pk, tr)
            float zBot = lo + loIdx * step
            float zTop = lo + (hiIdx + 1) * step
            int rowCnt = hiIdx - loIdx + 1
            bool closeOK = bull ? zTop < cClose : zBot > cClose
            if zTop > zBot and rowCnt >= minRows
                if closeOK
                    array.push(out, Zone.new(zTop, zBot, array.size(out) + array.size(rej) + 1))
                else
                    array.push(rej, Zone.new(zTop, zBot, array.size(out) + array.size(rej) + 1))
            i := tr + stepDir
    [out, rej]

// ───────────────────────────────────────────────────────────────────────────────
//  ⑥-B  ZONE BOX DRAWINGS  ·  باکس‌های ناحیه فیکس‌رنج مستقل از ستاپ‌ها
// ───────────────────────────────────────────────────────────────────────────────
var array<line>  zLines   = array.new<line>()
var array<box>   zBoxes   = array.new<box>()
var array<float> zTopArr  = array.new<float>()
var array<float> zBotArr  = array.new<float>()
var array<int>   zDirArr  = array.new<int>()
var array<box>   rzBoxes  = array.new<box>()
var int   zoneCount    = 0
var int   zoneRejected = 0
var float lastZoneTop  = na
var float lastZoneBot  = na
var line  pocLine   = na
var line  vaHiLine  = na
var line  vaLoLine  = na
var label pocLabel  = na
var int   lastProfBars = 0
var float lastPocPx    = na

// نمایش «ناحیه ردشده» (کلوز داخلش بود) — برای اینکه ببینید موتور کار می‌کند
f_drawRejected(int bi, float zTop, float zBot) =>
    box rb = box.new(bi, zTop, bi + 30, zBot, xloc = xloc.bar_index, border_color = color.new(color.gray, 45), border_width = 1, border_style = line.style_dotted, bgcolor = color.new(color.gray, 92))
    array.push(rzBoxes, rb)
    while array.size(rzBoxes) > 18
        box.delete(array.shift(rzBoxes))
    true

f_drawZone(int bi, float zTop, float zBot, int dir, int idx) =>
    color zc = idx == 1 ? (dir == 1 ? color.new(color.teal, 0) : color.new(color.orange, 0)) : color.new(color.gray, 20)
    line tL = line.new(bi, zTop, bi, zTop, xloc.bar_index, extend.right, zc, line.style_solid, 2)
    line bL = line.new(bi, zBot, bi, zBot, xloc.bar_index, extend.right, zc, line.style_solid, 2)
    box  bx = na
    if zoneFill
        bx := box.new(bi, zTop, bi + 1, zBot, xloc = xloc.bar_index, border_color = color.new(zc, 70), border_width = 1, bgcolor = color.new(zc, 82))
    array.push(zLines, tL)
    array.push(zLines, bL)
    array.push(zBoxes, bx)
    array.push(zTopArr, zTop)
    array.push(zBotArr, zBot)
    array.push(zDirArr, dir)
    true

f_dropZone(int i) =>
    line.delete(array.get(zLines, 2 * i))
    line.delete(array.get(zLines, 2 * i + 1))
    box.delete(array.get(zBoxes, i))
    array.remove(zLines, 2 * i + 1)
    array.remove(zLines, 2 * i)
    array.remove(zBoxes, i)
    array.remove(zTopArr, i)
    array.remove(zBotArr, i)
    array.remove(zDirArr, i)
    true

// ── چرخهٔ عمر : باکس وقتی پاک می‌شود که قیمت از «سمت دور» آن بسته شود ──
//    صعودی (باکس زیر قیمت) ← Close زیر کف باکس
//    نزولی (باکس بالای قیمت) ← Close بالای سقف باکس
if clearUsedZones and array.size(zDirArr) > 0
    for i = array.size(zDirArr) - 1 to 0
        int zdir = array.get(zDirArr, i)
        float zT = array.get(zTopArr, i)
        float zB = array.get(zBotArr, i)
        bool dead = zdir == 1 ? close < zB : close > zT
        if dead
            f_dropZone(i)

// باکس‌های زنده تا لبهٔ راست چارت کشیده می‌شوند (داخل سقف ۵۰۰ کندل)
if barstate.islast and array.size(zBoxes) > 0
    for i = 0 to array.size(zBoxes) - 1
        box b = array.get(zBoxes, i)
        if not na(b)
            box.set_right(b, bar_index + 499)

// ───────────────────────────────────────────────────────────────────────────────
//  ⑥-C  POSITION SIZING  ·  حجم بر اساس ریسک یا درصد سرمایه
// ───────────────────────────────────────────────────────────────────────────────
f_qty(float px, float sl) =>
    float risk = math.abs(px - sl)
    float q = 0.0
    if qtyMode == "Risk % | ریسک ثابت"
        if risk > 0
            q := strategy.equity * riskPct / 100.0 / risk
    else
        if px > 0
            q := strategy.equity * qtyPct / 100.0 / px
    float capQty = px > 0 ? strategy.equity * maxLeverage / px : q
    q := math.min(q, capQty)
    if roundQty
        q := math.floor(q)
    math.max(q, 0.0)

// ───────────────────────────────────────────────────────────────────────────────
//  ⑦ SETUP FACTORY
// ───────────────────────────────────────────────────────────────────────────────
f_newSetup(int d, Zone z, int zBi) =>
    Setup.new(dir = d, stage = 0, zTop = z.top, zBot = z.bot, zIdx = z.idx, zBi = zBi, note = "ثبت شد")

f_pruneSetups() =>
    //  ⚠ ستاپ stage=7 (در معامله) هرگز حذف نمی‌شود (§۷-۲ معامله باز به‌زور بسته نشود).
    //  اول ستاپ‌های پایان‌یافته (stage=8)، بعد قدیمی‌ترین ستاپِ فعال قبل از ورود (stage<7) حذف می‌شود.
    while array.size(setups) > maxSetups
        int pick = -1
        if array.size(setups) > 0
            for k = 0 to array.size(setups) - 1
                Setup c = array.get(setups, k)
                if c.stage == 8
                    pick := k
                    break
        if pick < 0
            for k = 0 to array.size(setups) - 1
                Setup c = array.get(setups, k)
                if c.stage < 7
                    pick := k
                    break
        if pick < 0
            break   // همه ستاپ‌ها در معامله‌اند — بیش از این حذف نمی‌کنیم
        Setup old = array.remove(setups, pick)
        f_killSetup(old)
    true

// ───────────────────────────────────────────────────────────────────────────────
//  ⑧ PER-BAR : TF AGGREGATION
// ───────────────────────────────────────────────────────────────────────────────
f_step(aggS, newS)
f_step(aggM, newM)
f_step(agg1, new1)

// micro bars of the current structure period → جمع می‌شوند داخل حلقهٔ پردازش ساختار (پایین‌تر)

// ───────────────────────────────────────────────────────────────────────────────
//  ⑨ READY-SELECTION HELPERS
// ───────────────────────────────────────────────────────────────────────────────
f_bestReady(array<Pin> ps, int kind) =>
    int idx = -1
    float best = na
    for i = 0 to array.size(ps) - 1
        Pin p = array.get(ps, i)
        if p.status == 1 and p.kind == kind
            float lv = kind == 1 ? p.lo : p.hi
            if na(best) or (kind == 1 ? lv < best : lv > best)
                best := lv
                idx := i
    idx

f_hasBetterActive(array<Pin> ps, int kind, float readyLevel) =>
    bool res = false
    for i = 0 to array.size(ps) - 1
        Pin p = array.get(ps, i)
        if p.status == 0 and p.kind == kind
            float lv = kind == 1 ? p.lo : p.hi
            if kind == 1 ? lv < readyLevel : lv > readyLevel
                res := true
    res

f_killSetup(Setup s) =>
    f_delLine(s.l3)
    f_delLine(s.l4)
    f_delLine(s.l5)
    f_delLine(s.l6)
    f_delLine(s.l7)
    f_delLine(s.l8)
    f_delLine(s.l9)
    f_delLine(s.l10)
    f_delLabel(s.tag)
    f_delLabel(s.midLbl)
    true

f_cancelDir(int dir) =>
    //  ستاپ‌های بدون پوزیشن باز لغو می‌شوند (شامل stage=6 / مسلح).
    //  اگر ستاپ در stage=6 بود و سفارش معلق داشت، سفارش هم لغو می‌شود.
    //  پوزیشن باز (stage=7) هرگز لغو/بسته نمی‌شود — مطابق §۲-۹.
    if array.size(setups) > 0
        for i = array.size(setups) - 1 to 0
            Setup s = array.get(setups, i)
            if s.dir == dir and s.stage < 7
                bool wasArmC = s.stage == 6
                s.stage := 8
                s.note := "لغو (تغییر روند)"
                if wasArmC and entryPending and not na(trSetup) and trSetup == s
                    strategy.cancel("L")
                    strategy.cancel("S")
                    entryPending := false
                    trSetup := na
                f_killSetup(s)
                array.remove(setups, i)
    true

// ───────────────────────────────────────────────────────────────────────────────
//  ⑩ STRUCTURE CLOSE ENGINE  (کندل مهم · Ready · pin · روند · فیکس‌رنج)
// ───────────────────────────────────────────────────────────────────────────────
if aggS.closedNow
    Candle sb = aggS.cl
    array.push(structBars, sb)
    if array.size(structBars) > 400
        array.shift(structBars)
    int nS = array.size(structBars)

    // ── تشخیص جفت‌کندل‌ها و ثبت کاندید کندل مهم ──
    if nS >= 2
        Candle a = array.get(structBars, nS - 2)
        Candle b = array.get(structBars, nS - 1)
        if f_lowPair(a, b)
            [impH, impL, impBi] = f_pickLow(a, b)
            float refLo = math.min(a.c, b.o)
            array.push(pins, Pin.new(1, impH, impL, impBi, b.bi, refLo, 0))
        if f_highPair(a, b)
            [impH2, impL2, impBi2] = f_pickHigh(a, b)
            float refHi = math.max(a.c, b.o)
            array.push(pins, Pin.new(-1, impH2, impL2, impBi2, b.bi, refHi, 0))

    // ── چرخهٔ عمر کاندیدها : ابطال / Ready ──
    if array.size(pins) > 0
        for i = 0 to array.size(pins) - 1
            Pin p = array.get(pins, i)
            if p.status == 0 and sb.bi > p.startBi
                bool dead = p.kind == 1 ? (sb.o < p.ref or sb.c < p.ref) : (sb.o > p.ref or sb.c > p.ref)
                if dead
                    p.status := -1
                else
                    bool rdyC = p.kind == 1 ? sb.c > p.hi : sb.c < p.lo
                    if rdyC
                        p.status := 1

    // ── Ready با تناوب سخت BU↔BE ──
    // expectedReady: 0=آزاد، 1=نوبت BU، -1=نوبت BE
    bool readyBuNow = false
    bool readyBeNow = false
    if array.size(pins) > 0
        if expectedReady == 0 or expectedReady == 1
            int iBU = f_bestReady(pins, 1)
            if iBU >= 0
                Pin pBU = array.get(pins, iBU)
                if not f_hasBetterActive(pins, 1, pBU.lo)
                    readyBuNow := true
                    evRdyBU := true
                    lastBUpin := pBU.lo
                    lastBUpinRef := pBU.ref
                    lastBUpinHi := pBU.hi
                    buActive := true
                    pinSeq += 1
                    buSeq := pinSeq
                    lowestBUpin := na(lowestBUpin) ? pBU.lo : math.min(lowestBUpin, pBU.lo)
                    label.new(pBU.bi, pBU.lo, "کندل مهم پایین‌ترین\nReady BU · pinBU", xloc.bar_index, yloc.price, color.new(color.blue, 10), label.style_label_up, color.white, size.small)
                    expectedReady := -1
                    array.clear(pins)
                    if trend == 0 and beActive and not na(lastBEpin)
                        tempBoxTop := lastBEpin
                        tempBoxBot := lastBUpin
                    else if trend == -1 and not na(lastBEpin)
                        LL := lastBUpin
                        LH := lastBEpin
                        lhPinHi := lastBEpin
                        lhPinRef := lastBEpinRef
                        lhPinLo := lastBEpinLo
                        lhPinSeq := beSeq
                        llPinLo := lastBUpin
                        llPinRef := lastBUpinRef
                        llPinHi := lastBUpinHi
                        llPinSeq := buSeq
        if (expectedReady == 0 or expectedReady == -1) and array.size(pins) > 0
            int iBE = f_bestReady(pins, -1)
            if iBE >= 0
                Pin pBE = array.get(pins, iBE)
                if not f_hasBetterActive(pins, -1, pBE.hi)
                    readyBeNow := true
                    evRdyBE := true
                    lastBEpin := pBE.hi
                    lastBEpinRef := pBE.ref
                    lastBEpinLo := pBE.lo
                    beActive := true
                    pinSeq += 1
                    beSeq := pinSeq
                    highestBE := na(highestBE) ? pBE.hi : math.max(highestBE, pBE.hi)
                    label.new(pBE.bi, pBE.hi, "کندل مهم بالاترین\nReady BE · pinBE", xloc.bar_index, yloc.price, color.new(color.maroon, 10), label.style_label_down, color.white, size.small)
                    expectedReady := 1
                    array.clear(pins)
                    if trend == 0 and buActive and not na(lastBUpin)
                        tempBoxTop := lastBEpin
                        tempBoxBot := lastBUpin
                    else if trend == 1 and not na(lastBUpin)
                        HH := lastBEpin
                        HL := lastBUpin
                        hlPinLo := lastBUpin
                        hlPinRef := lastBUpinRef
                        hlPinHi := lastBUpinHi
                        hlPinSeq := buSeq
                        hhPinHi := lastBEpin
                        hhPinRef := lastBEpinRef
                        hhPinLo := lastBEpinLo
                        hhPinSeq := beSeq

    // ── تعیین / ادامه / تغییر روند و ابطال پین‌ها (§4-1 سند نهایی) ──
    if trend == 0
        if not na(tempBoxTop) and not na(tempBoxBot)
            if sb.c > tempBoxTop
                trend := 1
                highestBE := tempBoxTop
                lowestBUpin := tempBoxBot
                tempBoxTop := na
                tempBoxBot := na
                HH := na
                HL := na
                beActive := false
                buActive := true
                if buSeq < beSeq
                    pinSeq += 1
                    buSeq := pinSeq
                expectedReady := -1
                evTrendUp := true
            else if sb.c < tempBoxBot
                trend := -1
                highestBE := tempBoxTop
                lowestBUpin := tempBoxBot
                tempBoxTop := na
                tempBoxBot := na
                LL := na
                LH := na
                buActive := false
                beActive := true
                if beSeq < buSeq
                    pinSeq += 1
                    beSeq := pinSeq
                expectedReady := 1
                evTrendDn := true
        if trend == 0 and sb.bi > 0
            if not readyBuNow and buActive and not na(lastBUpinRef) and beSeq <= buSeq
                bool crossedRefBU = sb.o < lastBUpinRef or sb.c < lastBUpinRef
                bool crossedLowBU = not na(lastBUpin) and (sb.o < lastBUpin or sb.c < lastBUpin)
                if crossedRefBU or crossedLowBU
                    float oldBUInvalid = lastBUpin
                    buActive := false
                    lastBUpin := na
                    lastBUpinRef := na
                    lastBUpinHi := na
                    tempBoxTop := na
                    tempBoxBot := na
                    expectedReady := beActive ? 1 : 0
                    label.new(sb.bi, oldBUInvalid, "pinBU بی‌اعتبار شد · پین پاک شد", xloc.bar_index, yloc.price, color.new(color.red, 30), label.style_label_up, color.white, size.tiny)
            if not readyBeNow and beActive and not na(lastBEpinRef) and buSeq <= beSeq
                bool crossedRefBE = sb.o > lastBEpinRef or sb.c > lastBEpinRef
                bool crossedHighBE = not na(lastBEpin) and (sb.o > lastBEpin or sb.c > lastBEpin)
                if crossedRefBE or crossedHighBE
                    float oldBEInvalid = lastBEpin
                    beActive := false
                    lastBEpin := na
                    lastBEpinRef := na
                    lastBEpinLo := na
                    tempBoxTop := na
                    tempBoxBot := na
                    expectedReady := buActive ? -1 : 0
                    label.new(sb.bi, oldBEInvalid, "pinBE بی‌اعتبار شد · پین پاک شد", xloc.bar_index, yloc.price, color.new(color.red, 30), label.style_label_down, color.white, size.tiny)
    else if trend == 1
        if not na(HL) and sb.c < HL
            float oldHL = HL
            float oldHH = HH
            trend := -1
            evChgDn := true
            highestBE := oldHH
            lowestBUpin := oldHL
            HH := na
            HL := na
            LL := na
            LH := na
            buActive := false
            lastBUpin := na
            lastBUpinRef := na
            lastBUpinHi := na
            if not na(hhPinHi)
                lastBEpin := hhPinHi
                lastBEpinRef := hhPinRef
                lastBEpinLo := hhPinLo
                beActive := true
                pinSeq += 1
                beSeq := pinSeq
            expectedReady := 1
        else
            if not na(HH) and sb.c > HH
                if buSeq < beSeq
                    beActive := false
                    lastBEpin := na
                    lastBEpinRef := na
                    lastBEpinLo := na
                    HH := na
                    HL := na
                    if not na(hlPinLo)
                        lastBUpin := hlPinLo
                        lastBUpinRef := hlPinRef
                        lastBUpinHi := hlPinHi
                        buActive := true
                        buSeq := hlPinSeq
                    expectedReady := -1
                else
                    HH := na
                    HL := na
                    expectedReady := -1
            if not readyBeNow and beActive and not na(lastBEpinRef) and buSeq <= beSeq and sb.bi > 0
                bool crossedRefBE = sb.o > lastBEpinRef or sb.c > lastBEpinRef
                bool crossedHighBE = not na(lastBEpin) and (sb.o > lastBEpin or sb.c > lastBEpin)
                if crossedRefBE or crossedHighBE
                    float oldBEInvalid = lastBEpin
                    beActive := false
                    lastBEpin := na
                    lastBEpinRef := na
                    lastBEpinLo := na
                    HH := na
                    HL := na
                    if not na(hlPinLo)
                        lastBUpin := hlPinLo
                        lastBUpinRef := hlPinRef
                        lastBUpinHi := hlPinHi
                        buActive := true
                        buSeq := hlPinSeq
                    expectedReady := buActive ? -1 : 0
                    label.new(sb.bi, oldBEInvalid, "pinBE بی‌اعتبار شد · پین پاک شد", xloc.bar_index, yloc.price, color.new(color.red, 30), label.style_label_down, color.white, size.tiny)
            if not readyBuNow and buActive and not na(lastBUpinRef) and beSeq <= buSeq and sb.bi > 0
                bool crossedRefBU = sb.o < lastBUpinRef or sb.c < lastBUpinRef
                bool crossedLowBU = not na(lastBUpin) and (sb.o < lastBUpin or sb.c < lastBUpin)
                if crossedRefBU or crossedLowBU
                    float oldBUInvalid = lastBUpin
                    buActive := false
                    lastBUpin := na
                    lastBUpinRef := na
                    lastBUpinHi := na
                    expectedReady := beActive ? 1 : 0
                    label.new(sb.bi, oldBUInvalid, "pinBU بی‌اعتبار شد · پین پاک شد", xloc.bar_index, yloc.price, color.new(color.red, 30), label.style_label_up, color.white, size.tiny)
    else if trend == -1
        if not na(LH) and sb.c > LH
            float oldLH = LH
            float oldLL = LL
            trend := 1
            evChgUp := true
            highestBE := oldLH
            lowestBUpin := oldLL
            HH := na
            HL := na
            LL := na
            LH := na
            beActive := false
            lastBEpin := na
            lastBEpinRef := na
            lastBEpinLo := na
            if not na(llPinLo)
                lastBUpin := llPinLo
                lastBUpinRef := llPinRef
                lastBUpinHi := llPinHi
                buActive := true
                pinSeq += 1
                buSeq := pinSeq
            expectedReady := -1
        else
            if not na(LL) and sb.c < LL
                if beSeq < buSeq
                    buActive := false
                    lastBUpin := na
                    lastBUpinRef := na
                    lastBUpinHi := na
                    LL := na
                    LH := na
                    if not na(lhPinHi)
                        lastBEpin := lhPinHi
                        lastBEpinRef := lhPinRef
                        lastBEpinLo := lhPinLo
                        beActive := true
                        beSeq := lhPinSeq
                    expectedReady := 1
                else
                    LL := na
                    LH := na
                    expectedReady := 1
            if not readyBuNow and buActive and not na(lastBUpinRef) and beSeq <= buSeq and sb.bi > 0
                bool crossedRefBU = sb.o < lastBUpinRef or sb.c < lastBUpinRef
                bool crossedLowBU = not na(lastBUpin) and (sb.o < lastBUpin or sb.c < lastBUpin)
                if crossedRefBU or crossedLowBU
                    float oldBUInvalid = lastBUpin
                    buActive := false
                    lastBUpin := na
                    lastBUpinRef := na
                    lastBUpinHi := na
                    LL := na
                    LH := na
                    if not na(lhPinHi)
                        lastBEpin := lhPinHi
                        lastBEpinRef := lhPinRef
                        lastBEpinLo := lhPinLo
                        beActive := true
                        beSeq := lhPinSeq
                    expectedReady := beActive ? 1 : 0
                    label.new(sb.bi, oldBUInvalid, "pinBU بی‌اعتبار شد · پین پاک شد", xloc.bar_index, yloc.price, color.new(color.red, 30), label.style_label_up, color.white, size.tiny)
            if not readyBeNow and beActive and not na(lastBEpinRef) and buSeq <= beSeq and sb.bi > 0
                bool crossedRefBE = sb.o > lastBEpinRef or sb.c > lastBEpinRef
                bool crossedHighBE = not na(lastBEpin) and (sb.o > lastBEpin or sb.c > lastBEpin)
                if crossedRefBE or crossedHighBE
                    float oldBEInvalid = lastBEpin
                    beActive := false
                    lastBEpin := na
                    lastBEpinRef := na
                    lastBEpinLo := na
                    expectedReady := buActive ? -1 : 0
                    label.new(sb.bi, oldBEInvalid, "pinBE بی‌اعتبار شد · پین پاک شد", xloc.bar_index, yloc.price, color.new(color.red, 30), label.style_label_down, color.white, size.tiny)

    if evChgDn or evTrendDn
        f_cancelDir(1)
    if evChgUp or evTrendUp
        f_cancelDir(-1)

    // §4-8: با بسته‌شدن کندل ساختار بعدی، پنجرهٔ مسلح مجدد بسته می‌شود.
    if array.size(setups) > 0
        for j = 0 to array.size(setups) - 1
            Setup rearmSetup = array.get(setups, j)
            int rearmBars = math.max(1, math.round(secS / sec2))
            bool fullStructureElapsed = not na(rearmSetup.armBi) and (bar_index - rearmSetup.armBi) >= rearmBars
            if rearmSetup.stage == 4 and rearmSetup.rearmAllowed and fullStructureElapsed
                rearmSetup.stage := 8
                rearmSetup.rearmAllowed := false
                rearmSetup.note := "گذشت یک کندل ساختار کامل؛ مسلح مجدد ممنوع"
                label.new(sb.bi, close, "مسلح مجدد ممنوع · کندل ساختار کامل", xloc.bar_index, yloc.price, color.new(color.gray, 30), label.style_label_left, color.white, size.tiny)
            else if rearmSetup.stage == 7 and rearmSetup.rearmAllowed and fullStructureElapsed
                // معامله باز می‌ماند؛ فقط اجازه مسلح‌مجدد بعدی بسته می‌شود.
                rearmSetup.rearmAllowed := false

    // ── پروفایل حجم فیکس‌رنج کندل ساختار + ثبت ناحیه‌ها ──
    bool bullC = sb.c > sb.o
    bool bearC = sb.c < sb.o
    bool dirOK = (trend == 1 and bullC) or (trend == -1 and bearC)
    Profile prof = f_buildProfile(microS, vpRows, vpVA, distMode, vpSmooth)
    if dirOK and not na(prof.step) and prof.step > 0
        [zs, rejZs] = f_zones(prof, vpRows, bullC, sb.c, minZoneRows)
        zoneRejected += array.size(rejZs)
        if showRejectedZones and array.size(rejZs) > 0
            for i = 0 to array.size(rejZs) - 1
                Zone rz = array.get(rejZs, i)
                f_drawRejected(sb.bi, rz.top, rz.bot)
        if array.size(zs) > 0
            for i = 0 to array.size(zs) - 1
                Zone z = array.get(zs, i)
                if z.top > z.bot
                    if drawZones
                        f_drawZone(sb.bi, z.top, z.bot, trend, z.idx)
                    lastZoneTop := z.top
                    lastZoneBot := z.bot
                    zoneCount += 1
                    cSetup += 1
                    array.push(setups, f_newSetup(trend, z, sb.bi))
            if drawZones
                while array.size(zDirArr) > maxZoneBoxes
                    f_dropZone(0)
            f_pruneSetups()
    // ── نمایش POC و Value Area برای مقایسه با ابزار TradingView ──
    lastProfBars := array.size(microS)
    if showPocVA and not na(prof.poc) and prof.step > 0
        lastPocPx := prof.poc
        pocLine := f_setLine(pocLine, sb.bi, prof.poc, color.new(color.yellow, 0))
        vaHiLine := f_setLine(vaHiLine, sb.bi, prof.vaHi, color.new(color.gray, 30))
        vaLoLine := f_setLine(vaLoLine, sb.bi, prof.vaLo, color.new(color.gray, 30))
        f_delLabel(pocLabel)
        pocLabel := label.new(sb.bi, prof.poc, "POC " + str.tostring(prof.poc, format.mintick) + " · VA " + str.tostring(prof.vaLo, format.mintick) + " - " + str.tostring(prof.vaHi, format.mintick), xloc.bar_index, yloc.price, color.new(color.yellow, 55), label.style_label_left, color.black, size.tiny)

    // ── نمایش اعداد پروفایل برای N کندل آخر ──
    if vpShow and vpShowN > 0 and not na(prof.step) and prof.step > 0 and array.size(microS) > 2
        int xPos = sb.t + int(secS * 1000 / 2)
        for r = 0 to vpRows - 1
            float rMid = prof.lo + r * prof.step + prof.step / 2
            label lb = label.new(xPos, rMid, str.tostring(array.get(prof.vol, r), format.volume), xloc.bar_time, yloc.price, color.new(color.white, 100), label.style_none, color.new(color.gray, 20), size.tiny, text.align_center)
            array.push(vpLabels, lb)
        while array.size(vpLabels) > vpShowN * vpRows
            label.delete(array.shift(vpLabels))

// ── ریزکندل‌های تریگر۲ داخل کندل ساختار جاری ──
if newS
    microS.clear()
if array.size(microS) > 3000
    array.shift(microS)
array.push(microS, Candle.new(bar_index, time, open, high, low, close, volume))

// ───────────────────────────────────────────────────────────────────────────────
//  ⑪ MIDDLE CLOSE ENGINE  (تایید میانی · کندل مارک‌شده · ابطال)
// ───────────────────────────────────────────────────────────────────────────────
if aggM.closedNow and not na(aggM.cl) and array.size(setups) > 0
    Candle mc = aggM.cl
    for i = 0 to array.size(setups) - 1
        Setup s = array.get(setups, i)
        if s.stage >= 1 and s.stage < 7
            if na(s.midRef) and (na(s.touchMidStart) or mc.t >= s.touchMidStart)
                // ✔ تایید میانی
                s.midRef := s.dir == 1 ? mc.l : mc.h
                s.midBi := mc.bi
                s.midConfirmBi := bar_index
                s.markBi := na
                s.markH := na
                s.markL := na
                s.stage := 2
                cMid += 1
                s.lvReEntered := false
                s.l3 := f_setLine(s.l3, mc.bi, s.midRef, color.new(color.gray, 0))
                f_delLabel(s.midLbl)
                s.midLbl := label.new(mc.bi, s.midRef, s.dir == 1 ? "کف تایید میانی" : "سقف تایید میانی", xloc.bar_index, yloc.price, color.new(color.gray, 10), label.style_label_right, color.white, size.small)
            else if not na(s.midRef)
                // ✖ ابطال تایید میانی — قبل از مارک چک می‌شود، چون کندل مارک هم
                //   می‌تواند سطح را بشکند (§۶-۱۲). ۷-۷ رفع شد.
                bool broken = false
                if midInvalid == "Close | بسته شدن"
                    broken := s.dir == 1 ? mc.c < s.midRef : mc.c > s.midRef
                else
                    broken := s.dir == 1 ? mc.l < s.midRef : mc.h > s.midRef
                if broken
                    //  اگر ستاپ مسلح بود (stage=6) سفارش pending را لغو می‌کنیم —
                    //  ۷-۱۱: سفارش یتیم بعد از ابطال میانی.
                    bool wasArmed = s.stage == 6
                    float oldMid = s.midRef
                    f_delLine(s.l3)
                    f_delLabel(s.midLbl)
                    s.l3 := na
                    s.midLbl := na
                    s.midRef := na
                    s.markBi := na
                    s.touchMidStart := aggM.cur.t
                    s.stage := 2
                    s.lvBi := na
                    s.lvConfBi := na
                    s.lvH := na
                    s.lvL := na
                    s.hvBi := na
                    s.hvConfBi := na
                    s.hvScanBi := na
                    s.runMax := na
                    s.lvTouched := false
                    s.lvUsed := false
                    s.lvReEntered := false
                    f_delLine(s.l4)
                    f_delLine(s.l5)
                    f_delLine(s.l6)
                    f_delLine(s.l7)
                    f_delLine(s.l8)
                    s.l4 := na
                    s.l5 := na
                    s.l6 := na
                    s.l7 := na
                    s.l8 := na
                    if wasArmed and entryPending and not na(trSetup) and trSetup == s
                        strategy.cancel("L")
                        strategy.cancel("S")
                        entryPending := false
                        trSetup := na
                    label.new(mc.bi, oldMid, "تایید میانی باطل شد", xloc.bar_index, yloc.price, color.new(color.red, 30), label.style_label_right, color.white, size.tiny)
                else if na(s.markBi)
                    // ◆ مارک کردن کندل بعد از تایید (فقط نشانه) — فقط اگر ابطال اتفاق نیفتاده
                    s.markH := mc.h
                    s.markL := mc.l
                    s.markBi := mc.bi
                    if s.stage == 2
                        s.stage := 3

// ───────────────────────────────────────────────────────────────────────────────
//  ⑫ TRIGGER-1 CLOSE ENGINE  ·  ناحیه ولوم کم (در تایم‌فریم تریگر۱)
//     کندل با ولوم کمتر از کندل قبل مارک می‌شود .
//     تایید : بسته شدن بالای سقف (صعودی) / زیر کف (نزولی) بدون رسیدن به سمت مخالف
//     ابطال : رسیدن به سمت مخالف ← کندل جدید جست‌وجو می‌شود
//     قاعده یک‌بارمصرف : باکس فقط یک‌بار برگشت و خروج دارد
// ───────────────────────────────────────────────────────────────────────────────
var float prevT1Vol = na
if agg1.closedNow and not na(agg1.cl) and array.size(setups) > 0
    Candle q1 = agg1.cl
    for i = 0 to array.size(setups) - 1
        Setup s = array.get(setups, i)
        if s.stage >= 2 and s.stage <= 7 and not na(s.midRef) and q1.bi > s.midConfirmBi
            bool bullL = s.dir == 1
            bool lvConfirmedNow = false
            // ── مارک / تایید / ابطال کندل ولوم کم (پیش از تایید اولیهٔ باکس) ──
            if not s.lvUsed and na(s.lvConfBi) and s.stage <= 4
                if na(s.lvBi)
                    if na(prevT1Vol) or q1.v < prevT1Vol
                        s.lvBi := q1.bi
                        s.lvH := q1.h
                        s.lvL := q1.l
                        label.new(q1.bi, bullL ? q1.l : q1.h, "کندل ولوم کم (تریگر۱)", xloc.bar_index, yloc.price, color.new(color.yellow, 40), bullL ? label.style_label_up : label.style_label_down, color.black, size.tiny)
                else
                    bool violL = bullL ? q1.l < s.lvL : q1.h > s.lvH
                    bool confL = bullL ? q1.c > s.lvH : q1.c < s.lvL
                    if violL
                        s.lvBi := na
                        s.lvH := na
                        s.lvL := na
                    else if confL
                        s.lvConfBi := bar_index
                        lvConfirmedNow := true
                        s.stage := 4
                        cLV += 1
                        s.lvTouched := false
                        s.lvReEntered := false
                        s.hvScanBi := na
                        s.hvBi := na
                        if hvScan == "LV Confirm | لحظه تایید ناحیه ولوم کم"
                            s.hvScanBi := bar_index
                        s.l4 := f_setLine(s.l4, s.lvBi, s.lvH, color.new(color.yellow, 0))
                        s.l5 := f_setLine(s.l5, s.lvBi, s.lvL, color.new(color.yellow, 0))
                        label.new(q1.bi, bullL ? s.lvH : s.lvL, "ناحیه ولوم کم ✔  (تریگر۱)", xloc.bar_index, yloc.price, color.new(color.yellow, 15), bullL ? label.style_label_up : label.style_label_down, color.black, size.small)
            // ── ابطال باکس ولوم کم پس از تایید (§4-7 سند نهایی) ──
            if not lvConfirmedNow and not na(s.lvBi) and not na(s.lvConfBi) and not s.lvUsed
                bool lvViolAfter = bullL ? q1.l < s.lvL : q1.h > s.lvH
                if lvViolAfter
                    if s.stage == 4 or s.stage == 5
                        s.lvBi := na
                        s.lvConfBi := na
                        s.lvH := na
                        s.lvL := na
                        s.lvTouched := false
                        s.lvReEntered := false
                        s.hvBi := na
                        s.hvConfBi := na
                        s.hvScanBi := na
                        s.runMax := na
                        s.stage := 3
                        f_delLine(s.l4); f_delLine(s.l5); f_delLine(s.l6); f_delLine(s.l7)
                        s.l4 := na; s.l5 := na; s.l6 := na; s.l7 := na
                        label.new(q1.bi, bullL ? q1.l : q1.h, "ناحیه ولوم کم باطل شد ✖", xloc.bar_index, yloc.price, color.new(color.red, 30), bullL ? label.style_label_up : label.style_label_down, color.white, size.tiny)
                    else if s.stage == 6 or s.stage == 7
                        s.lvUsed := true
                        s.rearmAllowed := false
                        f_delLine(s.l4); f_delLine(s.l5)
                        s.l4 := na; s.l5 := na
            // ── یک‌بارمصرف بودن باکس ولوم کم ──
            //   کندل تاییدکننده برگشت نیست؛ بعد از اولین لمس، خروج فقط با کلوز سنجیده می‌شود.
            //   در stage=6 باکس مصرف می‌شود ولی سفارش معلق طبق تصمیم مالک زنده می‌ماند.
            if not lvConfirmedNow and not na(s.lvBi) and not s.lvUsed and s.stage >= 4 and s.stage <= 7
                bool insideBox = q1.l <= s.lvH and q1.h >= s.lvL
                if insideBox and not s.lvTouched
                    s.lvTouched := true
                    if na(s.hvScanBi) and hvScan == "First LV Touch | اولین برگشت به باکس ولوم کم"
                        s.hvScanBi := q1.bi
                else if s.lvTouched
                    bool leftBox = bullL ? q1.c > s.lvH : q1.c < s.lvL
                    if leftBox
                        s.lvUsed := true
                        f_delLine(s.l4)
                        f_delLine(s.l5)
                        s.l4 := na
                        s.l5 := na
                        if s.stage == 4 or s.stage == 5
                            s.stage := 8
                            s.note := "باکس ولوم کم مصرف شد پیش از مسلح شدن"
                            f_delLine(s.l6); f_delLine(s.l7); f_delLine(s.l8); f_delLine(s.l9); f_delLine(s.l10)
                            s.l6 := na; s.l7 := na; s.l8 := na; s.l9 := na; s.l10 := na
                        else if s.stage == 6
                            // پس از مسلح شدن، مصرف LV باکس را می‌بندد اما سفارش را زنده می‌گذارد.
                            s.note := "باکس ولوم کم مصرف شد؛ سفارش مسلح زنده ماند"
                        else if s.stage == 7
                            // معامله ادامه دارد، اما باکس مصرف‌شده دیگر اجازه مسلح‌مجدد نمی‌دهد.
                            s.rearmAllowed := false
                        label.new(q1.bi, bullL ? s.lvH : s.lvL, "باکس ولوم کم مصرف شد ✖", xloc.bar_index, yloc.price, color.new(color.silver, 30), bullL ? label.style_label_up : label.style_label_down, color.black, size.tiny)
prevT1Vol := agg1.closedNow ? agg1.cl.v : prevT1Vol

// ───────────────────────────────────────────────────────────────────────────────
//  ⑬ TRIGGER-2 (CHART) ENGINE : ناحیه ساختار · ناحیه ولوم زیاد · ورود · مدیریت
// ───────────────────────────────────────────────────────────────────────────────
if array.size(setups) > 0
    for i = 0 to array.size(setups) - 1
        Setup s = array.get(setups, i)
        bool bull = s.dir == 1

        // ④ انقضا / ورود بعد از مسلح‌شدن (§4-8 و §4-9 سند نهایی)
        if s.stage == 6 and bar_index > s.hvConfBi
            bool openBreak = bull ? (not na(s.priceExpiryRef) and open > s.priceExpiryRef) : (not na(s.priceExpiryRef) and open < s.priceExpiryRef)
            bool closeBreak = bull ? (not na(s.priceExpiryRef) and close > s.priceExpiryRef) : (not na(s.priceExpiryRef) and close < s.priceExpiryRef)
            int nBars = math.max(1, math.round(secS / sec2))
            bool barExpire = not na(s.armBi) and (bar_index - s.armBi) >= nBars
            bool entryTouched = bull ? low <= s.hvH : high >= s.hvL
            bool hvViol = bull ? low < s.hvL : high > s.hvH
            if barExpire or openBreak or (not entryTouched and closeBreak)
                string expRsn = barExpire ? "گذشت یک کندل ساختار" : "عبور باز/کلوز از پین مخالف"
                s.hvBi := na
                s.runMax := volume
                s.stage := (s.lvUsed or barExpire) ? 8 : 4
                s.note := "سفارش منقضی · " + expRsn
                s.rearmAllowed := s.stage == 4
                if entryPending and not na(trSetup) and trSetup == s
                    strategy.cancel("L"); strategy.cancel("S")
                    entryPending := false
                    trSetup := na
                f_delLine(s.l6); f_delLine(s.l7); f_delLine(s.l8); f_delLine(s.l9); f_delLine(s.l10)
                s.l6 := na; s.l7 := na; s.l8 := na; s.l9 := na; s.l10 := na
                label.new(bar_index, close, "انقضا · " + expRsn, xloc.bar_index, yloc.price, color.new(color.orange, 30), label.style_label_left, color.white, size.tiny)
            else if entryTouched
                s.entry := bull ? s.hvH : s.hvL
                s.stage := 7
                s.entryBi := bar_index
                cEntry += 1
                lastEntryPx := s.entry
                lastSlPx := s.sl
                lastTpPx := s.tpx
                evEntryB := bull
                evEntryS := not bull
                label.new(bar_index, s.entry, (bull ? "ورود خرید" : "ورود فروش") + " @ " + str.tostring(s.entry, format.mintick), xloc.bar_index, yloc.price, color.new(bull ? color.green : color.red, 10), bull ? label.style_label_up : label.style_label_down, color.white, size.small)
            else if hvViol
                s.hvBi := na
                s.runMax := volume
                s.stage := s.lvUsed ? 8 : 4
                s.note := "نقض HV؛ جست‌وجوی دوباره"
                s.prevEntry := na
                s.rearmAllowed := false
                if entryPending and not na(trSetup) and trSetup == s
                    strategy.cancel("L"); strategy.cancel("S")
                    entryPending := false
                    trSetup := na
                f_delLine(s.l6); f_delLine(s.l7); f_delLine(s.l8); f_delLine(s.l9); f_delLine(s.l10)
                s.l6 := na; s.l7 := na; s.l8 := na; s.l9 := na; s.l10 := na
                label.new(bar_index, close, "نقض HV · اسکن از نو", xloc.bar_index, yloc.price, color.new(color.orange, 30), label.style_label_left, color.white, size.tiny)

        // هنگام معامله باز، نقض ساختار/میانی فقط مسلح‌مجدد را می‌بندد؛ خود معامله ادامه دارد.
        if s.stage == 7 and s.rearmAllowed and bar_index > s.zBi and (bull ? close < s.zBot : close > s.zTop)
            s.rearmAllowed := false
        if s.stage == 7 and s.rearmAllowed and not na(s.midRef) and bar_index > s.midConfirmBi
            bool rearmMidBroken = midInvalid == "Close | بسته شدن" ? (bull ? close < s.midRef : close > s.midRef) : (bull ? low < s.midRef : high > s.midRef)
            if rearmMidBroken
                s.rearmAllowed := false
        // §4-6: ابطال تایید میانی روی تک‌تک کندل‌های بستهٔ تریگر۲؛ یک عبور کوتاه کافی است.
        if s.stage >= 2 and s.stage <= 6 and not na(s.midRef) and bar_index > s.midConfirmBi
            bool brokenMid = midInvalid == "Close | بسته شدن" ? (bull ? close < s.midRef : close > s.midRef) : (bull ? low < s.midRef : high > s.midRef)
            if brokenMid
                bool wasArmedMid = s.stage == 6
                float oldMid = s.midRef
                s.midRef := na
                s.midBi := na
                s.markBi := na
                s.touchMidStart := aggM.cur.t
                s.stage := 2
                s.lvBi := na; s.lvConfBi := na; s.lvH := na; s.lvL := na; s.hvBi := na; s.hvConfBi := na; s.hvScanBi := na; s.runMax := na
                s.lvTouched := false; s.lvUsed := false; s.lvReEntered := false
                f_delLine(s.l3); f_delLine(s.l4); f_delLine(s.l5); f_delLine(s.l6); f_delLine(s.l7); f_delLine(s.l8); f_delLine(s.l9); f_delLine(s.l10)
                s.l3 := na; s.l4 := na; s.l5 := na; s.l6 := na; s.l7 := na; s.l8 := na; s.l9 := na; s.l10 := na
                f_delLabel(s.midLbl); s.midLbl := na
                if wasArmedMid and entryPending and not na(trSetup) and trSetup == s
                    strategy.cancel("L"); strategy.cancel("S")
                    entryPending := false
                    trSetup := na
                label.new(bar_index, oldMid, "تایید میانی باطل شد (تریگر۲)", xloc.bar_index, yloc.price, color.new(color.red, 30), label.style_label_right, color.white, size.tiny)

        // ① برخورد به ناحیه فیکس‌رنج ساختار
        if s.stage == 0 and not s.zGone and bar_index > s.zBi
            bool touch = low <= s.zTop and high >= s.zBot
            if touch
                s.stage := 1
                cTouch += 1
                s.touchBi := bar_index
                s.touchMidStart := aggM.cur.t
                label.new(bar_index, bull ? s.zBot : s.zTop, "برخورد · منتظر بسته شدن کندل میانی", xloc.bar_index, yloc.price, color.new(color.silver, 20), label.style_label_left, color.black, size.tiny)

        // ② پاک شدن / لغو ناحیه ساختار (کلوز از سمت دور)
        if s.stage < 7 and not s.zGone and bar_index > s.zBi
            bool broken = bull ? close < s.zBot : close > s.zTop
            if broken
                bool wasArmedZ = s.stage == 6
                s.zGone := true
                s.stage := 8
                s.note := "شکست ناحیه ساختار (لغو)"
                if wasArmedZ and entryPending and not na(trSetup) and trSetup == s
                    strategy.cancel("L")
                    strategy.cancel("S")
                    entryPending := false
                    trSetup := na
                f_killSetup(s)
                label.new(bar_index, close, "لغو · شکست ناحیه ساختار", xloc.bar_index, yloc.price, color.new(color.red, 40), label.style_label_down, color.white, size.tiny)

        // ②-ب ابطال باکس ولوم کم پس از تایید با عبور ۱ تیک از سمت مخالف (§4-7 سند نهایی)
        if not s.lvUsed and not na(s.lvBi) and not na(s.lvConfBi) and bar_index > s.lvConfBi
            bool lvViol = bull ? low < s.lvL : high > s.lvH
            if lvViol
                if s.stage == 4 or s.stage == 5
                    s.lvBi := na
                    s.lvConfBi := na
                    s.lvH := na
                    s.lvL := na
                    s.lvTouched := false
                    s.lvReEntered := false
                    s.hvBi := na
                    s.hvConfBi := na
                    s.hvScanBi := na
                    s.runMax := na
                    s.stage := 3
                    f_delLine(s.l4); f_delLine(s.l5); f_delLine(s.l6); f_delLine(s.l7)
                    s.l4 := na; s.l5 := na; s.l6 := na; s.l7 := na
                    label.new(bar_index, bull ? low : high, "ناحیه ولوم کم باطل شد ✖", xloc.bar_index, yloc.price, color.new(color.red, 30), bull ? label.style_label_up : label.style_label_down, color.white, size.tiny)
                else if s.stage == 6 or s.stage == 7
                    s.lvUsed := true
                    s.rearmAllowed := false
                    f_delLine(s.l4); f_delLine(s.l5)
                    s.l4 := na; s.l5 := na

        // ③-الف بازگشت قیمت به باکس ولوم کم ← از این لحظه اسکن ولوم زیاد فعال می‌شود
        if s.stage == 4 and not s.zGone and not na(s.lvBi) and not s.lvReEntered
            if low <= s.lvH and high >= s.lvL
                s.lvReEntered := true
                if na(s.hvScanBi)
                    s.hvScanBi := bar_index
                s.runMax := volume
                label.new(bar_index, bull ? s.lvH : s.lvL, "بازگشت به باکس ولوم کم · اسکن ولوم زیاد", xloc.bar_index, yloc.price, color.new(color.yellow, 25), bull ? label.style_label_up : label.style_label_down, color.black, size.tiny)

        // ③-ب ناحیه ولوم زیاد (تریگر۲)
        if s.stage >= 4 and s.stage <= 5 and not na(s.lvBi) and s.lvReEntered
            bool scanOK = na(s.hvScanBi) ? true : bar_index >= s.hvScanBi
            if scanOK
                bool marked = not na(s.hvBi)
                bool viol = marked and (bull ? low < s.hvL : high > s.hvH)
                bool conf = marked and (bull ? close > s.hvH : close < s.hvL)
                if viol
                    // ✖ نقض کندل مارک‌شده ← ناحیه حذف و کندل ولوم زیاد جدید جست‌وجو می‌شود
                    s.hvBi := na
                    s.runMax := volume
                    s.stage := 4
                    f_delLine(s.l6)
                    f_delLine(s.l7)
                    s.l6 := na
                    s.l7 := na
                else if conf
                    // ✔ ناحیه ولوم زیاد تایید شد → مسلح
                    //   ⚠ فقط اگر کارگزار/استراتژی در حال حاضر سفارش/پوزیشن باز نداشته باشد
                    //   stage=6 می‌رویم.
                    float eRef = bull ? s.hvH : s.hvL
                    s.sl := bull ? s.hvL - slBufTicks * syminfo.mintick : s.hvH + slBufTicks * syminfo.mintick
                    float a0 = bull ? highestBE : lowestBUpin
                    float a1 = s.midRef
                    bool haveFib = not na(a0) and not na(a1) and (bull ? a0 > a1 : a0 < a1)
                    float tp1loc = na
                    float tp2loc = na
                    float tpxloc = na
                    if haveFib
                        float R = bull ? a0 - a1 : a1 - a0
                        tp1loc := bull ? a1 + 0.382 * R : a1 - 0.382 * R
                        tp2loc := bull ? a1 + 0.5 * R : a1 - 0.5 * R
                        tpxloc := bull ? a1 + 1.272 * R : a1 - 1.272 * R
                    else
                        tpxloc := bull ? eRef + minTPunits : eRef - minTPunits
                    bool tpXMovedToMinimum = false
                    float tpXFallbackDistance = na
                    if bull
                        tpXMovedToMinimum := tpxloc - eRef < minTPunits
                        if tpXMovedToMinimum
                            tpxloc := eRef + minTPunits
                        if haveFib
                            if tpXMovedToMinimum
                                tpXFallbackDistance := tpxloc - eRef
                                tp1loc := eRef + tpXFallbackDistance * 0.382
                                tp2loc := eRef + tpXFallbackDistance * 0.5
                            else
                                if na(tp1loc) or tp1loc <= eRef
                                    tp1loc := eRef + (tpxloc - eRef) * 0.382
                                if na(tp2loc) or tp2loc <= eRef
                                    tp2loc := eRef + (tpxloc - eRef) * 0.5
                    else
                        tpXMovedToMinimum := eRef - tpxloc < minTPunits
                        if tpXMovedToMinimum
                            tpxloc := eRef - minTPunits
                        if haveFib
                            if tpXMovedToMinimum
                                tpXFallbackDistance := eRef - tpxloc
                                tp1loc := eRef - tpXFallbackDistance * 0.382
                                tp2loc := eRef - tpXFallbackDistance * 0.5
                            else
                                if na(tp1loc) or tp1loc >= eRef
                                    tp1loc := eRef - (eRef - tpxloc) * 0.382
                                if na(tp2loc) or tp2loc >= eRef
                                    tp2loc := eRef - (eRef - tpxloc) * 0.5
                    // مسلح‌مجدد فقط تا پیش از گذشت یک بازهٔ ساختار کامل از آخرین arm مجاز است؛
                    // ورود هم باید بهتر باشد. نقض HV، prevEntry را پاک می‌کند و اسکن را از نو می‌سازد.
                    bool hasActiveOrder = false
                    for m = 0 to array.size(setups) - 1
                        if m != i
                            Setup o = array.get(setups, m)
                            if o.stage == 6 or o.stage == 7
                                hasActiveOrder := true
                    bool isRearm = not na(s.prevEntry)
                    bool betterEntry = bull ? eRef < s.prevEntry : eRef > s.prevEntry
                    bool rearmPrereqs = not s.zGone and not na(s.midRef) and not na(s.lvBi) and s.lvReEntered and not s.lvUsed
                    bool rearmOK = not isRearm or (s.rearmAllowed and rearmPrereqs and betterEntry)
                    bool canArm = rearmOK and not hasActiveOrder and not entryPending and strategy.position_size == 0
                    if not canArm
                        s.hvBi := na
                        s.runMax := volume
                        f_delLine(s.l6)
                        f_delLine(s.l7)
                        s.l6 := na
                        s.l7 := na
                    else
                        s.tp1 := tp1loc
                        s.tp2 := tp2loc
                        s.tpx := tpxloc
                        s.entry := eRef
                        s.be := false
                        s.tp2Hit := false
                        s.stage := 6
                        cHV += 1
                        s.hvConfBi := bar_index
                        s.armBi := bar_index
                        s.armsSinceS += 1
                        s.prevEntry := eRef
                        s.priceExpiryRef := bull ? lastBEpin : lastBUpin
                        s.rearmAllowed := true
                        evArmedB := bull
                        evArmedS := not bull
                        if showTrade
                            s.l8 := f_setLine(s.l8, bar_index, eRef, color.new(color.lime, 0))
                            s.l9 := f_setLine(s.l9, bar_index, s.sl, color.new(color.red, 0))
                            s.l10 := f_setLine(s.l10, bar_index, s.tpx, color.new(color.fuchsia, 0))
                        label.new(bar_index, eRef, bull ? "مسلح برای خرید (Armed)" : "مسلح برای فروش (Armed)", xloc.bar_index, yloc.price, color.new(bull ? color.green : color.red, 20), bull ? label.style_label_up : label.style_label_down, color.white, size.small)

                        // ── ثبت اوردر ورود (بای/سل لیمیت روی لبهٔ ناحیه ولوم زیاد) ──
                        trSetup := s
                        trDir := bull ? 1 : -1
                        trEntry := eRef
                        trSl := s.sl
                        trTp1 := s.tp1
                        trTp2 := s.tp2
                        trTp := s.tpx
                        be1 := false
                        float qq = f_qty(eRef, s.sl)
                        if qq > 0
                            trQ1 := qq * 0.33
                            trQ2 := qq * 0.33
                            trQ3 := qq * 0.34
                            trTp1Done := false
                            trTp2Done := false
                            trTp2Hit := false
                            if bull
                                strategy.entry("L", strategy.long, qty = qq, limit = eRef, comment = "PinReady-L")
                            else
                                strategy.entry("S", strategy.short, qty = qq, limit = eRef, comment = "PinReady-S")
                            entryPending := true
                            entryBar := bar_index
                else
                    // ◆ مارک / به‌روزرسانی کندل ولوم زیاد
                    bool markNow = false
                    if hvMarkMode == "RunningMax | بیشترین حجم تا این لحظه"
                        markNow := volume > nz(s.runMax, 0.0)
                    else
                        markNow := na(s.hvBi) and volume > volume[1]
                    if markNow
                        s.hvBi := bar_index
                        s.hvH := high
                        s.hvL := low
                        s.runMax := volume
                        s.stage := 5
                        s.l6 := f_setLine(s.l6, bar_index, high, color.new(color.blue, 0))
                        s.l7 := f_setLine(s.l7, bar_index, low, color.new(color.blue, 0))
                        label.new(bar_index, bull ? low : high, "کندل ولوم زیاد (مارک)", xloc.bar_index, yloc.price, color.new(color.blue, 25), bull ? label.style_label_up : label.style_label_down, color.white, size.tiny)

        // ⑤ مدیریت معامله : حدضرر / سر‌به‌سر / حدسود
        //   ترتیب: SL/TPX اول پایان می‌دهند. TP1 و TP2 پله‌های میانی‌اند و می‌توانند در
        //   یک کندل هر دو لمس شوند (۷-۱۳: در یک کندل فقط TP1 ثبت می‌شد).
        if s.stage == 7 and not na(s.sl) and not na(s.tpx)
            bool done = false
            float px = na
            string note = ""
            bool sameBar = s.entryBi == bar_index  // کندلی که ورود در آن پر شد
            if bull
                if low <= s.sl
                    done := true
                    px := s.sl
                    note := s.be ? "خروج سر‌به‌سر" : "حد ضرر"
                else if high >= s.tpx
                    done := true
                    px := s.tpx
                    note := "حد سود نهایی (1.272)"
                else
                    // §۶-۲۱: ورود و TP1 در یک کندل → BE خالص (نتیجه صفر)
                    // §۶-۲۱: ورود و TP1 در یک کندل → BE خالص (نتیجه صفر)
                    bool sameBarNZ = sameBar and not na(s.tp1) and high >= s.tp1 and low <= s.entry
                    if sameBarNZ
                        s.be := true
                        done := true
                        px := s.entry
                        note := "خروج سر‌به‌سر (TP1 و ورود یک کندل)"
                    if not sameBarNZ
                        if not s.be and not na(s.tp1) and high >= s.tp1
                            s.be := true
                            s.sl := s.entry
                            if not na(s.l9)
                                line.set_xy1(s.l9, bar_index, s.entry)
                                line.set_xy2(s.l9, bar_index, s.entry)
                                line.set_color(s.l9, color.new(color.orange, 0))
                            label.new(bar_index, s.entry, "TP1 (38%) ✔ · حدضرر = سر‌به‌سر", xloc.bar_index, yloc.price, color.new(color.orange, 20), label.style_label_down, color.white, size.tiny)
                        //  TP2: if مستقل
                        if s.be and not s.tp2Hit and not na(s.tp2) and high >= s.tp2
                            s.tp2Hit := true
                            label.new(bar_index, s.tp2, "TP2 (50%) ✔", xloc.bar_index, yloc.price, color.new(color.orange, 10), label.style_label_down, color.white, size.tiny)
                        if s.be and low <= s.entry
                            done := true
                            px := s.entry
                            note := "خروج سر‌به‌سر"
            else
                if high >= s.sl
                    done := true
                    px := s.sl
                    note := s.be ? "خروج سر‌به‌سر" : "حد ضرر"
                else if low <= s.tpx
                    done := true
                    px := s.tpx
                    note := "حد سود نهایی (1.272)"
                else
                    bool sameBarNZ2 = sameBar and not na(s.tp1) and low <= s.tp1 and high >= s.entry
                    if sameBarNZ2
                        s.be := true
                        done := true
                        px := s.entry
                        note := "خروج سر‌به‌سر (TP1 و ورود یک کندل)"
                    if not sameBarNZ2
                        if not s.be and not na(s.tp1) and low <= s.tp1
                            s.be := true
                            s.sl := s.entry
                            if not na(s.l9)
                                line.set_xy1(s.l9, bar_index, s.entry)
                                line.set_xy2(s.l9, bar_index, s.entry)
                                line.set_color(s.l9, color.new(color.orange, 0))
                            label.new(bar_index, s.entry, "TP1 (38%) ✔ · حدضرر = سر‌به‌سر", xloc.bar_index, yloc.price, color.new(color.orange, 20), label.style_label_up, color.white, size.tiny)
                        if s.be and not s.tp2Hit and not na(s.tp2) and low <= s.tp2
                            s.tp2Hit := true
                            label.new(bar_index, s.tp2, "TP2 (50%) ✔", xloc.bar_index, yloc.price, color.new(color.orange, 10), label.style_label_up, color.white, size.tiny)
                        if s.be and high >= s.entry
                            done := true
                            px := s.entry
                            note := "خروج سر‌به‌سر"
            if done
                lastResult := note
                s.note := note
                bool finalWin = str.contains(note, "1.272")
                bool rearmPrereqsAfterTrade = s.rearmAllowed and not s.zGone and not na(s.midRef) and not na(s.lvBi) and s.lvReEntered and not s.lvUsed
                if not finalWin and rearmPrereqsAfterTrade
                    s.stage := 4
                    s.hvBi := na
                    s.runMax := volume
                    // lvReEntered حفظ می‌شود: برگشت اول تریگر۱ انجام شده و برگشت دوم مجاز نیست.
                    s.be := false
                    s.tp2Hit := false
                else
                    s.stage := 8
                    s.rearmAllowed := false
                    cDone += 1
                f_delLine(s.l6)
                f_delLine(s.l7)
                f_delLine(s.l8)
                f_delLine(s.l9)
                f_delLine(s.l10)
                s.l6 := na
                s.l7 := na
                s.l8 := na
                s.l9 := na
                s.l10 := na
                label.new(bar_index, px, note + " @ " + str.tostring(px, format.mintick), xloc.bar_index, yloc.price, color.new(note == "حد ضرر" ? color.red : color.blue, 10), label.style_label_left, color.white, size.small)


// ───────────────────────────────────────────────────────────────────────────────
//  ⑮ STRATEGY ORDER MANAGEMENT  ·  لغو · ورود · خروج · سر‌به‌سر
//  ⚠ نکته حیاتی : strategy.exit اگر قبل از باز بودن پوزیشن صدا زده شود نادیده گرفته
//     می‌شود ؛ پس اینجا خروج‌ها «هر کندل» دوباره ثبت می‌شوند.
// ───────────────────────────────────────────────────────────────────────────────
bool setupAlive = not na(trSetup) and (trSetup.stage == 6 or trSetup.stage == 7)
bool flatNow = strategy.position_size == 0

// ① لغو سفارش ورود : فقط وقتی خود ستاپ باطل یا منقضی شده باشد
if flatNow and entryPending and not setupAlive
    strategy.cancel("L")
    strategy.cancel("S")
    entryPending := false

// ② تمدید سفارش ورود لیمیت و خروج‌های وابسته هر کندل (تا در کندل ورود نیز حدضرر/حدسود فعال باشد)
//   ۷-۸: سفارش در همان کندل مسلح شدن (bar_index == entryBar) پر نمی‌شود — مطابق
//   §۲-۸ «برگشت به لبه» از کندل بعد.
if flatNow and entryPending and setupAlive and not na(trEntry) and bar_index > entryBar
    if trDir == 1
        strategy.entry("L", strategy.long, qty = trQ1 + trQ2 + trQ3, limit = trEntry, comment = "PinReady-L")
        strategy.exit("X1", from_entry = "L", qty = trQ1, limit = trTp1, stop = trSl)
        strategy.exit("X2", from_entry = "L", qty = trQ2, limit = trTp2, stop = trSl)
        strategy.exit("X3", from_entry = "L", qty = trQ3, limit = trTp, stop = trSl)
    else
        strategy.entry("S", strategy.short, qty = trQ1 + trQ2 + trQ3, limit = trEntry, comment = "PinReady-S")
        strategy.exit("X1", from_entry = "S", qty = trQ1, limit = trTp1, stop = trSl)
        strategy.exit("X2", from_entry = "S", qty = trQ2, limit = trTp2, stop = trSl)
        strategy.exit("X3", from_entry = "S", qty = trQ3, limit = trTp, stop = trSl)

// ③ تشخیص پر شدن ورود
if not inPos and strategy.position_size != 0
    inPos := true
    entryPending := false

// ④ مدیریت پوزیشن : ثبت دوبارهٔ خروج‌ها روی هر کندل + سر‌به‌سر
if inPos and not na(trSl) and not na(trTp)
    bool pLong = strategy.position_size > 0
    if not trTp1Done and not na(trTp1) and (pLong ? high >= trTp1 : low <= trTp1)
        trTp1Done := true
    if trTp1Done and not be1
        be1 := true
    if not trTp2Done and not na(trTp2) and (pLong ? high >= trTp2 : low <= trTp2)
        trTp2Done := true
    float stopLvl = be1 ? trEntry : trSl
    if pLong
        if not trTp1Done
            strategy.exit("X1", from_entry = "L", qty = trQ1, limit = trTp1, stop = stopLvl)
        if not trTp2Done
            strategy.exit("X2", from_entry = "L", qty = trQ2, limit = trTp2, stop = stopLvl)
        strategy.exit("X3", from_entry = "L", qty = trQ3, limit = trTp, stop = stopLvl)
    else if strategy.position_size < 0
        if not trTp1Done
            strategy.exit("X1", from_entry = "S", qty = trQ1, limit = trTp1, stop = stopLvl)
        if not trTp2Done
            strategy.exit("X2", from_entry = "S", qty = trQ2, limit = trTp2, stop = stopLvl)
        strategy.exit("X3", from_entry = "S", qty = trQ3, limit = trTp, stop = stopLvl)
    // اگر ستاپ دیگر معتبر نیست ولی پوزیشن باز است → خروج همگام (سپر ایمنی)
    if not setupAlive
        strategy.close_all(comment = "sync-close")
        inPos := false

// ⑤ پایان معامله
if inPos and strategy.position_size == 0
    inPos := false
    entryPending := false
    be1 := false
    trTp1Done := false
    trTp2Done := false
    trSetup := na
    strategy.cancel("X1")
    strategy.cancel("X2")
    strategy.cancel("X3")

// ───────────────────────────────────────────────────────────────────────────────
//  ⑭ STATUS PANEL  +  WARNING  +  ALERTS
// ───────────────────────────────────────────────────────────────────────────────
var table panel = na
if showTable and barstate.islast
    if na(panel)
        panel := table.new(position.top_right, 2, 23, border_width = 1, frame_width = 1)
    Setup act = na
    int bestStage = -1
    if array.size(setups) > 0
        for i = 0 to array.size(setups) - 1
            Setup s = array.get(setups, i)
            if s.stage < 8 and s.stage > bestStage
                bestStage := s.stage
                act := s
    string trendTxt = trend == 1 ? "صعودی ▲" : trend == -1 ? "نزولی ▼" : "نامشخص —"
    color color1 = tfOK ? color.new(color.green, 75) : color.new(color.red, 70)
    string stgTxt = "—"
    string zoneTxt = "-"
    string entTxt = "-"
    string tpTxt = "-"
    if not na(act)
        stgTxt := f_stageFa(act.stage)
        zoneTxt := str.tostring(act.zTop, format.mintick) + " / " + str.tostring(act.zBot, format.mintick)
        entTxt := (na(act.entry) ? "-" : str.tostring(act.entry, format.mintick)) + " / " + (na(act.sl) ? "-" : str.tostring(act.sl, format.mintick))
        tpTxt := (na(act.tp1) ? "-" : str.tostring(act.tp1, format.mintick)) + " / " + (na(act.tp2) ? "-" : str.tostring(act.tp2, format.mintick)) + " / " + (na(act.tpx) ? "-" : str.tostring(act.tpx, format.mintick))
    table.cell(panel, 0, 0, "چارت / تریگر۲", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 0, timeframe.period + (tfOK ? " ✔" : " ⚠ باید " + tf2), text_color = color.white, bgcolor = color1, text_size = size.small)
    table.cell(panel, 0, 1, "روند (ساختار)", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 1, trendTxt, text_color = color.white, bgcolor = trend == 1 ? color.new(color.green, 40) : trend == -1 ? color.new(color.red, 40) : color.new(color.gray, 40), text_size = size.small)
    table.cell(panel, 0, 2, "HH / HL", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 2, (na(HH) ? "-" : str.tostring(HH, format.mintick)) + " / " + (na(HL) ? "-" : str.tostring(HL, format.mintick)), text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(panel, 0, 3, "LL / LH", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 3, (na(LL) ? "-" : str.tostring(LL, format.mintick)) + " / " + (na(LH) ? "-" : str.tostring(LH, format.mintick)), text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(panel, 0, 4, "آخرین pinBU / pinBE", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 4, (na(lastBUpin) ? "-" : str.tostring(lastBUpin, format.mintick)) + " / " + (na(lastBEpin) ? "-" : str.tostring(lastBEpin, format.mintick)), text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(panel, 0, 5, "مرحلهٔ ستاپ فعال", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 5, stgTxt, text_color = color.white, bgcolor = color.new(color.blue, 55), text_size = size.small)
    table.cell(panel, 0, 6, "ناحیه ساختار (top/bot)", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 6, zoneTxt, text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(panel, 0, 7, "Entry / SL", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 7, entTxt, text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(panel, 0, 8, "TP1 / TP2 / TP", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 8, tpTxt, text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    float netP = strategy.netprofit
    float wr = strategy.closedtrades > 0 ? strategy.wintrades * 100.0 / strategy.closedtrades : 0.0
    table.cell(panel, 0, 14, "باکس‌های ناحیه (زنده)", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 14, str.tostring(array.size(zDirArr)) + " / کل: " + str.tostring(zoneCount) + "  · ردشده: " + str.tostring(zoneRejected), text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(panel, 0, 15, "آخرین ناحیه ثبت‌شده", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 15, na(lastZoneTop) ? "-" : str.tostring(lastZoneTop, format.mintick) + " / " + str.tostring(lastZoneBot, format.mintick), text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(panel, 0, 19, "پروفایل آخرین کندل ساختار", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 19, str.tostring(lastProfBars) + " کندل · POC " + (na(lastPocPx) ? "-" : str.tostring(lastPocPx, format.mintick)), text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(panel, 0, 20, "زنجیره: ناحیه/برخورد/میانی", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 20, str.tostring(cSetup) + " / " + str.tostring(cTouch) + " / " + str.tostring(cMid), text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(panel, 0, 21, "زنجیره: ولوم‌کم/ولوم‌زیاد/ورود", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 21, str.tostring(cLV) + " / " + str.tostring(cHV) + " / " + str.tostring(cEntry), text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(panel, 0, 22, "آخرین معامله: ورود/SL/TP", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 22, (na(lastEntryPx) ? "-" : str.tostring(lastEntryPx, format.mintick)) + " / " + (na(lastSlPx) ? "-" : str.tostring(lastSlPx, format.mintick)) + " / " + (na(lastTpPx) ? "-" : str.tostring(lastTpPx, format.mintick)) + "  (" + lastResult + ")", text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(panel, 0, 16, "سود/زیان باز", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 16, str.tostring(strategy.openprofit, "#.##"), text_color = color.white, bgcolor = strategy.openprofit >= 0 ? color.new(color.green, 55) : color.new(color.red, 55), text_size = size.small)
    table.cell(panel, 0, 17, "پوزیشن / حجم", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 17, str.tostring(strategy.position_size, "#.####") + (entryPending ? "  (اوردر باز)" : ""), text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(panel, 0, 18, "حجم هر پله (۳۳/۳۳/۳۴٪)", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 18, na(trQ1) ? "-" : str.tostring(trQ1, "#.####") + " / " + str.tostring(trQ2, "#.####") + " / " + str.tostring(trQ3, "#.####"), text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(panel, 0, 9, "سود خالص / بازده", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 9, str.tostring(netP, "#.##") + "  (" + str.tostring(strategy.initial_capital > 0 ? netP * 100.0 / strategy.initial_capital : 0.0, "#.##") + "%)", text_color = color.white, bgcolor = netP >= 0 ? color.new(color.green, 45) : color.new(color.red, 45), text_size = size.small)
    table.cell(panel, 0, 10, "تعداد معاملات / برد", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 10, str.tostring(strategy.closedtrades) + " / " + str.tostring(strategy.wintrades) + "  (" + str.tostring(wr, "#.#") + "%)", text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(panel, 0, 11, "Profit Factor", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 11, str.tostring(strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : 0.0, "#.##"), text_color = color.white, bgcolor = color.new(color.black, 60), text_size = size.small)
    table.cell(panel, 0, 12, "Max Drawdown", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 12, str.tostring(strategy.max_drawdown, "#.##") + "  (" + str.tostring(strategy.max_drawdown_percent, "#.#") + "%)", text_color = color.white, bgcolor = color.new(color.red, 60), text_size = size.small)
    table.cell(panel, 0, 13, "وضعیت", text_color = color.white, bgcolor = color.new(color.black, 30), text_size = size.small)
    table.cell(panel, 1, 13, inPos ? "در معامله" : entryPending ? "اوردر باز" : "بدون پوزیشن", text_color = color.white, bgcolor = inPos ? color.new(color.blue, 50) : color.new(color.black, 60), text_size = size.small)


var label warnLbl = na
if barstate.islast and not tfOK
    if na(warnLbl)
        warnLbl := label.new(bar_index, high, "⚠️ چارت باید روی تایم‌فریم تریگر۲ (" + tf2 + ") باشد\nساختار " + tfS + " · میانی " + tfM + " · تریگر۱ " + tf1, xloc.bar_index, yloc.price, color.new(color.red, 10), label.style_label_down, color.white, size.normal)
    else
        label.set_xy(warnLbl, bar_index, high)

alertcondition(evRdyBU, "Ready BU · کندل مهم پایین‌ترین", "Ready BU شکل گرفت (کندل مهم پایین‌ترین + pinBU)")
alertcondition(evRdyBE, "Ready BE · کندل مهم بالاترین", "Ready BE شکل گرفت (کندل مهم بالاترین + pinBE)")
alertcondition(evTrendUp, "شروع روند صعودی", "روند صعودی تعیین شد (HH/HL)")
alertcondition(evTrendDn, "شروع روند نزولی", "روند نزولی تعیین شد (LL/LH)")
alertcondition(evChgUp, "تغییر روند به صعودی", "تغییر روند: نزولی → صعودی (Close بالای LH)")
alertcondition(evChgDn, "تغییر روند به نزولی", "تغییر روند: صعودی → نزولی (Close پایین HL)")
alertcondition(evArmedB, "Buy Armed · مسلح برای خرید", "ناحیه ولوم زیاد صعودی تایید شد — منتظر برگشت و ورود")
alertcondition(evArmedS, "Sell Armed · مسلح برای فروش", "ناحیه ولوم زیاد نزولی تایید شد — منتظر برگشت و ورود")
alertcondition(evEntryB, "ورود خرید", "برخورد با ناحیه ولوم زیاد صعودی — ورود خرید")
alertcondition(evEntryS, "ورود فروش", "برخورد با ناحیه ولوم زیاد نزولی — ورود فروش")
