// ───────────────────────────────────────────────────────────────────────────────
//  ④ HELPERS
// ───────────────────────────────────────────────────────────────────────────────
f_step(Agg a, bool isNew) =>
    a.closedNow := false
    if isNew
        if a.periods >= 2 and not na(a.cur)
            a.cl := Candle.new(a.cur.bi, a.cur.t, a.cur.o, a.cur.h, a.cur.l, a.cur.c, a.cur.v)
            a.closedNow := true
        a.cur := Candle.new(bar_index, time, open, high, low, close, volume)
        a.periods += 1
    else if na(a.cur)
        // کندل اول چارت: timeframe.change() روی بار صفر false است ، پس خودمان کندل جاری را می‌سازیم
        a.cur := Candle.new(bar_index, time, open, high, low, close, volume)
    else
        a.cur.h := math.max(a.cur.h, high)
        a.cur.l := math.min(a.cur.l, low)
        a.cur.c := close
        a.cur.v += volume
    a.closedNow

f_pinKind(bool isBullish) => isBullish ? 1 : -1

// کندل مهم در «پایین‌ترین‌ها» : کندل اول نزولی و کندل دوم صعودی
f_lowPair(Candle a, Candle b) => a.c < a.o and b.c > b.o

// کندل مهم در «بالاترین‌ها» : کندل اول صعودی و کندل دوم نزولی
f_highPair(Candle a, Candle b) => a.c > a.o and b.c < b.o

// انتخاب کندل مهم: کف/سقف بزرگ‌تر ؛ در حالت تساوی، شدوی کمتر
f_pickLow(Candle a, Candle b) =>
    float impH = na
    float impL = na
    int   impBi = na
    if a.l < b.l or (a.l == b.l and a.h < b.h)
        impH := a.h
        impL := a.l
        impBi := a.bi
    else
        impH := b.h
        impL := b.l
        impBi := b.bi
    [impH, impL, impBi]

f_pickHigh(Candle a, Candle b) =>
    float impH = na
    float impL = na
    int   impBi = na
    if a.h > b.h or (a.h == b.h and a.l < b.l)
        impH := a.h
        impL := a.l
        impBi := a.bi
    else
        impH := b.h
        impL := b.l
        impBi := b.bi
    [impH, impL, impBi]

f_setLine(line ln, int x, float y, color col) =>
    if na(ln)
        line.new(x, y, x, y, xloc.bar_index, extend.right, col, line.style_solid, 1)
    else
        line.set_xy1(ln, x, y)
        line.set_xy2(ln, x, y)
        line.set_color(ln, col)
        ln

f_delLine(line ln) =>
    if not na(ln)
        line.delete(ln)
    true

f_delLabel(label lb) =>
    if not na(lb)
        label.delete(lb)
    true

f_stageFa(int st) =>
    string r = "?"
    if st == 0
        r := "منتظر برخورد به ناحیه ساختار"
    else if st == 1
        r := "برخورد شد · منتظر بسته شدن کندل میانی"
    else if st == 2
        r := "تایید میانی ✔"
    else if st == 3
        r := "اسکن ناحیه ولوم کم (تریگر۱)"
    else if st == 4
        r := "ولوم کم ✔ · اسکن ولوم زیاد (تریگر۲)"
    else if st == 5
        r := "کندل ولوم زیاد (تریگر۲) مارک شد"
    else if st == 6
        r := "مسلح (Armed) · منتظر برگشت به ناحیه ولوم زیاد (تریگر۲)"
    else if st == 7
        r := "در معامله"
    else if st == 8
        r := "پایان‌یافته"
    r

